# Never commit real credentials. Copy to .env and fill in.
OPENAI_API_KEY=
OPENAI_MODEL=

JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Cohort is served from local bundles (data/fhir/bundles). A remote FHIR server is optional/unused.
FHIR_SOURCE=local
HAPI_FHIR_BASE_URL=

JEV_AUTO_THRESHOLD=0.90

# Fixed PA request (index) date for the whole cohort
PA_INDEX_DATE=2026-09-01

# Optional: reasoning effort for the GPT baseline (model default is 'medium')
OPENAI_REASONING_EFFORT=medium

# Hybrid pipeline: when to generate the GPT PA narrative (ready_only | all | none)
HYBRID_NARRATIVE=ready_only
